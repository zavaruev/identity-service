# Copy to .env and fill in. No real credentials belong in this repository.
# Empty secrets make the service fail closed, never open it up.

# Operator page / admin API (Basic authentication).
IDENTITY_ADMIN_USER=
IDENTITY_ADMIN_PASSWORD=
# Bearer token for the read endpoints (/api/profiles, /api/photos, /api/identify).
IDENTITY_TOKEN=
# Bearer token the gateway uses when it serves a live camera capture.
IDENTITY_CAPTURE_TOKEN=
# Optional key for the speaker-id engine's /enroll endpoint.
API_KEY=

# External services. Defaults assume Linux host networking on the same machine.
SPEAKER_ID_URL=http://localhost:8001
FACE_API_URL=http://localhost:8090
GATEWAY_URL=http://localhost:18792

# Deployment-specific: rooms offered by the picker and accepted by /api/record.
IDENTITY_ROOMS=room1,room2
